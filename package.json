{
  "name": "uptimekuma-discord-bot",
  "version": "1.1.6",
  "description": "Discord bot for Uptime Kuma monitoring - real-time status board and alerts",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "lint": "tsc -p tsconfig.test.json"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "discord.js": "^14.16.0",
    "dotenv": "^17.0.0",
    "fastify": "^5.2.0",
    "nodemailer": "^10.0.13",
    "p-queue": "^9.0.0",
    "pino": "^10.0.0",
    "socket.io-client": "^4.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.11",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
