# ---------------------------------------------------------------------------
# Uptime Kuma Discord Bot - environment configuration
#
# Copy to `.env` and fill in. Only the Discord + Kuma vars are REQUIRED;
# everything else is optional and can also be configured at runtime through
# slash commands (which are stored in data/bot.db and OVERRIDE these values).
# ---------------------------------------------------------------------------

# --- Discord (required) ---
# Bot token from https://discord.com/developers/applications → Bot
DISCORD_TOKEN=
# Application (client) ID from the same app's General Information page
DISCORD_CLIENT_ID=
# Guild (server) ID. Required: slash commands are registered on this one server.
DISCORD_GUILD_ID=
# Comma-separated Discord user IDs allowed to run /setup, /sg-setup, /sg-pause,
# /maintenance start|end, /pause, /resume, /phone toggle and /wp node add|remove,
# and who hold every /wp capability. When blank, nobody can run them (they
# answer "Admins only.").
ADMIN_USER_IDS=

# --- Web server ---
# Port for the health/debug HTTP server (/healthz, /readyz, /debug/*).
PORT=3100
# Bearer token for /debug/status, /debug/siteguard and /debug/smtp. Blank =
# those routes are not served (404). /healthz and /readyz are always open.
DEBUG_TOKEN=
# Comments go on their own lines in this file: `docker run --env-file` does not
# strip a trailing "# comment" and would make it part of the value.
#
# Encrypts the secrets saved through slash commands (SiteGuard API key, Zammad
# token, SMTP password, node agent tokens) in data/bot.db. Any long random string, e.g.
# `openssl rand -base64 32`. Existing plaintext values are encrypted on the next
# start. Keep it safe: if it is lost or changed, those values must be re-entered.
SETTINGS_ENCRYPTION_KEY=
# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Uptime Kuma (required) ---
# Socket.IO URL of the Kuma server. Prefer an internal/cluster URL to bypass
# any auth proxy in front of Kuma.
KUMA_URL=
# Optional. If Kuma has auth enabled, provide credentials. If Kuma is behind
# an auth proxy (e.g. Authentik) with its own login disabled, leave both blank
# and the bot auto-logs in.
KUMA_USERNAME=
KUMA_PASSWORD=
# Optional. Full Authorization header value for reaching Kuma through an auth
# proxy such as Authentik (intercept_header_auth: "Basic <base64 user:app-password>").
# When set, KUMA_URL is the public URL and the bot connects over websocket only.
# Never logged.
KUMA_AUTH_HEADER=

# --- SiteGuard WordPress health monitor (optional) ---
# Leave SG_HEALTH_URL blank to disable. Can also be set live via
# `/sg-setup connect <url> <api_key>` (DB setting wins over these env vars).
SG_HEALTH_URL=
SG_HEALTH_API_KEY=
# Poll interval in milliseconds.
SG_HEALTH_POLL_MS=60000
# Minutes between reminder alerts while a site stays down / WordPress stays
# unreachable (0 = a single alert per incident). Also settable via /sg-setup repeat.
SG_ALERT_REPEAT_MIN=30
# Bot-side direct HTTP probe of every known site, independent of the SiteGuard
# endpoint ("false" to disable). A site is DOWN after this many consecutive failures.
SG_DIRECT_PROBE=true
SG_DIRECT_PROBE_FAILS=2
# Also probe the sites reported by WordPress node agents from the bot ("true").
# Off by default: the node checks them itself.
SG_DIRECT_PROBE_NODES=false
# A down report from SiteGuard's own self-check counts after this many
# consecutive failures, or at once when the bot's direct probe fails too.
SG_SITE_DOWN_FAILS=3

# --- WordPress node agents for /wp (optional) ---
# Usually added at runtime with `/wp node add <name> <url> <token>` (stored in
# data/bot.db, which wins over these). To seed from the environment instead:
# comma-separated name=url pairs, plus one token per node in
# WPOPS_TOKEN_<NAME> (name upper-cased, "-" becomes "_"). URLs must be https://
# (http:// only on loopback or private addresses).
#WPOPS_NODES=web01=https://ops.example.com,web02=https://ops-standby.example.com
#WPOPS_TOKEN_WEB01=
#WPOPS_TOKEN_WEB02=
# Names shown on the status board. A label containing "standby" is shown as a
# backup node.
#WPOPS_NODE_LABELS=web01=web01 (production),web02=web02 (standby)
# Only monitor the sites of these nodes (comma-separated; unset = every node).
#WPOPS_SITE_NODES=web01
# Failed polls in a row (one a minute) before a node is reported unreachable.
#WPOPS_UNREACHABLE_AFTER=3

# --- Phone escalation (optional) ---
# "true" plus both PBX values: outages that stay down are reported to a PBX
# connector (POST <PBX_ALERT_URL>/alert and /resolve with a bearer token),
# which decides when to call. Toggle alert types with /phone toggle.
PHONE_ESCALATION_ENABLED=false
PBX_ALERT_URL=
PBX_ALERT_TOKEN=

# --- Zammad tickets (optional) ---
# When both are set, the bot opens ONE ticket per incident (site down,
# WordPress health endpoint unreachable) and closes it on recovery.
# Also configurable live via `/sg-setup tickets <url> <token> [group] [customer]`.
ZAMMAD_BASE_URL=
# Optional, used for links in Discord (defaults to the base URL).
ZAMMAD_PUBLIC_URL=
ZAMMAD_API_TOKEN=
ZAMMAD_TICKET_GROUP=Users
# Customer email; blank = auto-created "uptime-bot@<zammad host>".
ZAMMAD_TICKET_CUSTOMER=
ZAMMAD_TICKET_CLOSE_ON_RECOVERY=true
# fallback (default) = open an API ticket only when the alert EMAIL (which itself
# reaches the support mailbox / ticket system) could not be sent. always | off.
ZAMMAD_TICKET_MODE=fallback

# --- SMTP email alerts (optional) ---
# Can also be configured at runtime via `/setup smtp`. Omit user/pass for an
# unauthenticated relay (e.g. a Kubernetes postfix gateway on port 25).
SMTP_HOST=
SMTP_PORT=25
# "true" for implicit SSL (port 465).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Comma-separated recipients.
SMTP_TO=
# Verify the relay's TLS certificate. Defaults to false for cluster-internal
# hosts (*.svc.cluster.local, self-signed STARTTLS) and true otherwise.
SMTP_TLS_REJECT_UNAUTHORIZED=
